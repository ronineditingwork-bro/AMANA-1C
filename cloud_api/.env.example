# Скопируйте в cloud_api/.env и впишите два РАЗНЫХ случайных значения.
# Сгенерировать такое значение можно командой (Windows PowerShell):
#   -join ((48..57)+(97..122)|Get-Random -Count 32|%{[char]$_})

# Этот токен использует телефон/веб-панель — тот, кто создаёт задачи и смотрит результаты.
CLIENT_TOKEN=

# Этот токен использует только Local Agent на офисном компьютере.
AGENT_TOKEN=
