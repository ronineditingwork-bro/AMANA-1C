# Скопируйте в local_agent/.env и заполните.

# Адрес Cloud API. Пока сервер не выбран, для локальной проверки:
CLOUD_API_URL=http://127.0.0.1:8000

# Тот же AGENT_TOKEN, что в cloud_api/.env — скопируйте оттуда, значение должно совпадать один в один.
AGENT_TOKEN=

# Как часто спрашивать у облака "есть задача?", секунд.
AGENT_POLL_SECONDS=5

# --- Уведомления в Telegram о новых заказах (local_agent/telegram_notify.py) ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш chat_id (числа) — как узнать, см. cloud_api/../README.md, раздел про Telegram.
TELEGRAM_CHAT_ID=
# Как часто проверять новые заказы, секунд.
NOTIFY_POLL_SECONDS=60
