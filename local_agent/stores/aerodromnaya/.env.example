# Скопируйте в local_agent/stores/aerodromnaya/.env и заполните.
# Запуск: python local_agent/telegram_notify.py aerodromnaya

# Название магазина, попадёт в текст сообщения.
STORE_NAME=Аэродромная

# Адрес и логин OData именно этой базы 1С.
ONEC_ODATA_URL=http://192.168.1.10/ut11/odata/standard.odata/
ONEC_USER=odata.user
ONEC_PASSWORD=

# Токен бота и chat_id — можно свой на каждый магазин, можно один общий на оба
# (тогда сообщения будут в одном чате, но с пометкой "Магазин: ...").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно — можно не указывать, тогда возьмутся значения по умолчанию.
NOTIFY_POLL_SECONDS=60
NOTIFY_LOOKBACK_HOURS=48
