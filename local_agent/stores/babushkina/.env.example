# Скопируйте в local_agent/stores/babushkina/.env и заполните.
# Запуск: python local_agent/telegram_notify.py babushkina

# Название магазина, попадёт в текст сообщения.
STORE_NAME=Бабушкина

# Адрес и логин OData базы 1С этого магазина — впишите настоящий адрес.
# Как настроить OData на этой базе — см. README.md, раздел про второй магазин.
ONEC_ODATA_URL=http://ВПИШИТЕ_АДРЕС_ВТОРОЙ_1С/odata/standard.odata/
ONEC_USER=odata.user
ONEC_PASSWORD=

# Токен бота и chat_id — можно свой на каждый магазин, можно один общий на оба
# (тогда сообщения будут в одном чате, но с пометкой "Магазин: ...").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно — можно не указывать, тогда возьмутся значения по умолчанию.
NOTIFY_POLL_SECONDS=60
NOTIFY_LOOKBACK_HOURS=48
